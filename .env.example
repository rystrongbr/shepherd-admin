# Railway PostgreSQL (required in production)
DATABASE_URL=postgresql://user:password@host:5432/railway
# 256-bit secret. Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
GOOGLE_CLIENT_ID=
ANTHROPIC_MAX_CONCURRENT=20
RATE_LIMIT_ANONYMOUS_PER_DAY=3
# Emergency only; set true briefly to bypass quota enforcement.
RATE_LIMIT_BYPASS=false
# Must be one of the two first-party consumer origins.
DONATION_CHECKOUT_ORIGIN=https://app.myshepherdapp.church
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Apple App Store shared secret — App Store Connect → App Information →
# App-Specific Shared Secret. Required by POST /api/v1/iap/verify-receipt
# to authenticate calls to Apple's verifyReceipt endpoint. Never commit.
APPLE_SHARED_SECRET=

# ─── Google Play billing (Android) ──────────────────────────────────────────
# Package name of the Android app.
GOOGLE_PLAY_PACKAGE_NAME=church.myshepherdapp
# Service-account key JSON, base64-encoded (`base64 -i key.json | tr -d '\n'`).
# Grant it "View financial data" + "Manage orders and subscriptions" in Play Console.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Pub/Sub push subscription → https://app.myshepherdapp.church/api/v1/iap/google/rtdn
# with authentication enabled. Audience and push service-account email:
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=
# Play Console → App integrity → App signing key SHA-256 (comma-separated). Not secret.
GOOGLE_PLAY_SHA256_FINGERPRINTS=
# Google Play reviewer (google-review@myshepherdapp.church): bcrypt cost-12 hash.
REVIEWER_GOOGLE_PASSWORD_HASH=
# One-time opt-in to create the Free reviewer row; remove after first boot.
PROVISION_GOOGLE_REVIEWER=
