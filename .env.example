# Railway PostgreSQL (required in production)
DATABASE_URL=postgresql://user:password@host:5432/railway
# 256-bit secret. Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
GOOGLE_CLIENT_ID=
ANTHROPIC_MAX_CONCURRENT=20
RATE_LIMIT_ANONYMOUS_PER_DAY=3
# Emergency only; set true briefly to bypass quota enforcement.
RATE_LIMIT_BYPASS=false
# Must be one of the two first-party consumer origins.
DONATION_CHECKOUT_ORIGIN=https://app.myshepherdapp.church
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
